<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools">

    <!-- Lớp 1: cuộc gọi -->
    <uses-permission android:name="android.permission.READ_PHONE_STATE" />
    <uses-permission android:name="android.permission.READ_CALL_LOG" />
    <uses-permission android:name="android.permission.READ_CONTACTS" />
    <uses-permission android:name="android.permission.ANSWER_PHONE_CALLS" />
    <uses-permission android:name="android.permission.RECORD_AUDIO" />
    <!-- Lớp 2: tin nhắn (quyền đọc thông báo cấp trong Cài đặt) -->
    <uses-permission android:name="android.permission.POST_NOTIFICATIONS" />
    <!-- Lớp 3: nhắc trước khi chuyển tiền -->
    <uses-permission android:name="android.permission.PACKAGE_USAGE_STATS" tools:ignore="ProtectedPermissions" />
    <uses-permission android:name="android.permission.SYSTEM_ALERT_WINDOW" />
    <uses-permission android:name="android.permission.USE_FULL_SCREEN_INTENT" />
    <!-- Chạy nền -->
    <uses-permission android:name="android.permission.FOREGROUND_SERVICE" />
    <uses-permission android:name="android.permission.FOREGROUND_SERVICE_SPECIAL_USE" />
    <uses-permission android:name="android.permission.RECEIVE_BOOT_COMPLETED" />
    <uses-permission android:name="android.permission.REQUEST_IGNORE_BATTERY_OPTIMIZATIONS" />
    <uses-permission android:name="android.permission.INTERNET" />
    <uses-permission android:name="android.permission.VIBRATE" />

    <queries>
        <intent><action android:name="android.speech.RecognitionService" /></intent>
        <intent><action android:name="android.intent.action.TTS_SERVICE" /></intent>
    </queries>

    <application
        android:name=".LaChanApp"
        android:allowBackup="false"
        android:icon="@mipmap/ic_launcher"
        android:label="@string/ten_app"
        android:supportsRtl="true"
        android:theme="@style/GiaoDien"
        android:usesCleartextTraffic="true">

        <activity android:name=".MainActivity" android:exported="true" android:screenOrientation="portrait" android:windowSoftInputMode="adjustResize|stateHidden">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
        </activity>
        <activity android:name=".GoiVideoActivity" android:windowSoftInputMode="adjustResize" android:configChanges="orientation|screenSize|smallestScreenSize|screenLayout|keyboardHidden|keyboard|uiMode" android:exported="true" android:hardwareAccelerated="true" android:screenOrientation="portrait" />
        <activity android:name=".ThietLapActivity" android:exported="false" android:screenOrientation="portrait" />
        <activity android:name=".PhanTichTinNhanActivity" android:exported="false" android:screenOrientation="portrait" />
        <activity
            android:name=".HoiSauCuocGoiActivity"
            android:configChanges="orientation|screenSize|smallestScreenSize|screenLayout|keyboardHidden|keyboard|uiMode|fontScale|density|locale|layoutDirection"
            android:exported="false"
            android:screenOrientation="portrait"
            android:excludeFromRecents="true"
            android:launchMode="singleTask"
            android:showWhenLocked="true"
            android:taskAffinity="vn.doi18.lachanso.hoi"
            android:turnScreenOn="true" />
        <activity
            android:name=".DungLaiActivity"
            android:configChanges="orientation|screenSize|smallestScreenSize|screenLayout|keyboardHidden|keyboard|uiMode|fontScale|density|locale|layoutDirection"
            android:exported="false"
            android:screenOrientation="portrait"
            android:excludeFromRecents="true"
            android:launchMode="singleTask"
            android:showWhenLocked="true"
            android:taskAffinity="vn.doi18.lachanso.dung"
            android:theme="@style/GiaoDien.Do"
            android:turnScreenOn="true" />

        <!-- N1: sàng lọc cuộc gọi (không chặn, chỉ tra số và cảnh báo) -->
        <service
            android:name=".SangLocCuocGoi"
            android:exported="true"
            android:permission="android.permission.BIND_SCREENING_SERVICE">
            <intent-filter><action android:name="android.telecom.CallScreeningService" /></intent-filter>
        </service>

        <!-- N4: đọc thông báo tin nhắn -->
        <service
            android:name=".NgheThongBao"
            android:exported="true"
            android:label="@string/ten_app"
            android:permission="android.permission.BIND_NOTIFICATION_LISTENER_SERVICE">
            <intent-filter><action android:name="android.service.notification.NotificationListenerService" /></intent-filter>
        </service>

        <!-- N5: canh ứng dụng ngân hàng trong và sau cuộc gọi lạ -->
        <service
            android:name=".DichVuLaChan"
            android:exported="false"
            android:foregroundServiceType="specialUse">
            <property
                android:name="android.app.PROPERTY_SPECIAL_USE_FGS_SUBTYPE"
                android:value="Canh cuoc goi la va nhac truoc khi chuyen tien" />
        </service>

        <receiver android:name=".TheoDoiCuocGoi" android:exported="true">
            <intent-filter><action android:name="android.intent.action.PHONE_STATE" /></intent-filter>
        </receiver>
        <receiver android:name=".KhoiDongLai" android:exported="true">
            <intent-filter>
                <action android:name="android.intent.action.BOOT_COMPLETED" />
                <action android:name="android.intent.action.MY_PACKAGE_REPLACED" />
            </intent-filter>
        </receiver>
        <receiver android:name=".NutThongBao" android:exported="false" />
    </application>
</manifest>
