<resources>
    <style name="GiaoDien" parent="android:Theme.Material.Light.NoActionBar">
        <item name="android:colorPrimary">@color/brand</item>
        <item name="android:colorAccent">@color/brand</item>
        <item name="android:windowBackground">@color/bg</item>
        <item name="android:statusBarColor">@color/bg</item>
        <item name="android:windowLightStatusBar">true</item>
        <item name="android:navigationBarColor">@color/bg</item>
        <item name="android:fontFamily">@font/bvp_regular</item>
        <item name="android:textColor">@color/ink</item>
    </style>
    <style name="GiaoDien.Do">
        <item name="android:windowBackground">@color/danger</item>
        <item name="android:statusBarColor">@color/danger</item>
        <item name="android:windowLightStatusBar">false</item>
        <item name="android:navigationBarColor">@color/danger</item>
    </style>

    <style name="Chu"><item name="android:textColor">@color/ink</item><item name="android:fontFamily">@font/bvp_regular</item><item name="android:textSize">16sp</item><item name="android:lineSpacingMultiplier">1.15</item></style>
    <style name="Chu.Phu"><item name="android:textColor">@color/ink_2</item><item name="android:textSize">14sp</item></style>
    <style name="Chu.Dam"><item name="android:fontFamily">@font/bvp_semibold</item></style>
    <style name="Chu.TieuDe"><item name="android:fontFamily">@font/bvp_bold</item><item name="android:textSize">22sp</item></style>
    <style name="Chu.Lon"><item name="android:fontFamily">@font/bvp_bold</item><item name="android:textSize">26sp</item></style>
    <style name="Chu.Muc"><item name="android:fontFamily">@font/bvp_semibold</item><item name="android:textSize">13sp</item><item name="android:textColor">@color/ink_2</item><item name="android:letterSpacing">0.04</item></style>

    <style name="Nut">
        <item name="android:layout_width">match_parent</item>
        <item name="android:layout_height">wrap_content</item>
        <item name="android:minHeight">56dp</item>
        <item name="android:gravity">center</item>
        <item name="android:fontFamily">@font/bvp_bold</item>
        <item name="android:textSize">17sp</item>
        <item name="android:textAllCaps">false</item>
        <item name="android:stateListAnimator">@null</item>
        <item name="android:paddingStart">20dp</item>
        <item name="android:paddingEnd">20dp</item>
    </style>
    <style name="Nut.Chinh"><item name="android:background">@drawable/nut_chinh</item><item name="android:textColor">@color/surface</item></style>
    <style name="Nut.Do"><item name="android:background">@drawable/nut_do</item><item name="android:textColor">@color/surface</item></style>
    <style name="Nut.Xanh"><item name="android:background">@drawable/nut_xanh</item><item name="android:textColor">@color/surface</item></style>
    <style name="Nut.Vien"><item name="android:background">@drawable/nut_vien</item><item name="android:textColor">@color/ink</item></style>
    <style name="Nut.Trang"><item name="android:background">@drawable/nut_trang</item><item name="android:textColor">@color/danger_ink</item></style>
    <style name="Nut.VienTrang"><item name="android:background">@drawable/nut_vien_trang</item><item name="android:textColor">@color/surface</item></style>
    <style name="Nut.Nho"><item name="android:layout_width">wrap_content</item><item name="android:minHeight">40dp</item><item name="android:textSize">14sp</item><item name="android:background">@drawable/nut_chinh</item><item name="android:textColor">@color/surface</item><item name="android:minWidth">72dp</item></style>
</resources>
