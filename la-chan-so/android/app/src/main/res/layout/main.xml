<?xml version="1.0" encoding="utf-8"?>
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent" android:layout_height="match_parent"
    android:background="@color/bg" android:fitsSystemWindows="true">
    <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content" android:focusableInTouchMode="true" android:orientation="vertical" android:padding="20dp">
        <TextView style="@style/Chu.Lon" android:layout_width="match_parent" android:layout_height="wrap_content" android:text="Lá chắn số" />
        <TextView style="@style/Chu.Phu" android:layout_width="match_parent" android:layout_height="wrap_content" android:text="Phần chạy nền trên Android · bản thử của Đội 18" />

        <LinearLayout android:id="@+id/theTrangThai" android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginTop="16dp" android:background="@drawable/the_xanh" android:gravity="center_vertical" android:orientation="horizontal" android:padding="16dp">
            <ImageView android:id="@+id/nai" android:layout_width="76dp" android:layout_height="76dp" android:background="@drawable/nen_nai" android:clipToOutline="true" android:scaleType="centerCrop" android:src="@drawable/nai_chao" />
            <LinearLayout android:layout_width="0dp" android:layout_height="wrap_content" android:layout_marginStart="14dp" android:layout_weight="1" android:orientation="vertical">
                <TextView android:id="@+id/ttTieuDe" style="@style/Chu.TieuDe" android:layout_width="match_parent" android:layout_height="wrap_content" />
                <TextView android:id="@+id/ttPhu" style="@style/Chu.Phu" android:layout_width="match_parent" android:layout_height="wrap_content" android:textSize="15sp" />
            </LinearLayout>
        </LinearLayout>
        <Button android:id="@+id/nutThietLap" style="@style/Nut.Chinh" android:layout_marginTop="12dp" android:text="Thiết lập lá chắn" />

        <TextView style="@style/Chu.Muc" android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginTop="26dp" android:text="NGƯỜI THÂN NHẬN CẢNH BÁO" />
        <EditText android:id="@+id/tenNguoiThan" style="@style/Chu" android:layout_width="match_parent" android:layout_height="52dp" android:layout_marginTop="8dp" android:background="@drawable/o_nhap" android:hint="Tên gọi, ví dụ: Minh" android:inputType="textPersonName" android:paddingStart="14dp" android:paddingEnd="14dp" />
        <EditText android:id="@+id/soNguoiThan" style="@style/Chu" android:layout_width="match_parent" android:layout_height="52dp" android:layout_marginTop="8dp" android:background="@drawable/o_nhap" android:hint="Số điện thoại người thân" android:inputType="phone" android:paddingStart="14dp" android:paddingEnd="14dp" />

        <TextView style="@style/Chu.Muc" android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginTop="26dp" android:text="TÙY CHỌN" />
        <Spinner android:id="@+id/xungHo" android:layout_width="match_parent" android:layout_height="52dp" android:layout_marginTop="8dp" android:background="@drawable/o_nhap" android:paddingStart="6dp" android:paddingEnd="6dp" />
        <Switch android:id="@+id/hoiBangGiong" style="@style/Chu" android:layout_width="match_parent" android:layout_height="52dp" android:text="Hỏi bằng giọng nói sau cuộc gọi đáng ngờ" />
        <Switch android:id="@+id/trinhDien" style="@style/Chu" android:layout_width="match_parent" android:layout_height="wrap_content" android:minHeight="52dp" android:text="Chế độ trình diễn: ngưỡng 15 giây thay cho 5 phút" />
        <Switch android:id="@+id/goiSong" style="@style/Chu" android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginTop="8dp" android:minHeight="48dp" android:text="Gọi video: AI nói chuyện trực tiếp (cần khóa AI và khóa giọng đọc)" />
        <EditText android:id="@+id/khoaAI" style="@style/Chu" android:layout_width="match_parent" android:layout_height="52dp" android:layout_marginTop="8dp" android:background="@drawable/o_nhap" android:hint="Khóa AI (OpenAI), chỉ lưu trên máy này" android:importantForAutofill="no" android:inputType="textPassword" android:paddingStart="14dp" android:paddingEnd="14dp" />
        <EditText android:id="@+id/khoaGiong" style="@style/Chu" android:layout_width="match_parent" android:layout_height="52dp" android:layout_marginTop="8dp" android:background="@drawable/o_nhap" android:hint="Khóa giọng đọc (Gemini), nhiều khóa cách nhau dấu phẩy" android:importantForAutofill="no" android:inputType="textPassword" android:paddingStart="14dp" android:paddingEnd="14dp" />
        <EditText android:id="@+id/mayChu" style="@style/Chu" android:layout_width="match_parent" android:layout_height="52dp" android:layout_marginTop="8dp" android:background="@drawable/o_nhap" android:hint="Máy chủ của đội, ví dụ http://192.168.1.10:8787" android:inputType="textUri" android:paddingStart="14dp" android:paddingEnd="14dp" android:textSize="14sp" />
        <EditText android:id="@+id/appThu" style="@style/Chu" android:layout_width="match_parent" android:layout_height="52dp" android:layout_marginTop="8dp" android:background="@drawable/o_nhap" android:hint="Gói ứng dụng thử thay app ngân hàng (tùy chọn)" android:inputType="textUri" android:paddingStart="14dp" android:paddingEnd="14dp" android:textSize="14sp" />
        <EditText android:id="@+id/soThu" style="@style/Chu" android:layout_width="match_parent" android:layout_height="52dp" android:layout_marginTop="8dp" android:background="@drawable/o_nhap" android:hint="Số máy gọi thử, coi như số bị báo (tùy chọn)" android:inputType="phone" android:paddingStart="14dp" android:paddingEnd="14dp" android:textSize="14sp" />
        <Button android:id="@+id/nutLuu" style="@style/Nut.Vien" android:layout_marginTop="10dp" android:text="Lưu" />
        <Button android:id="@+id/nutBoChan" style="@style/Nut.Vien" android:layout_marginTop="8dp" android:visibility="gone" />

        <TextView style="@style/Chu.Muc" android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginTop="26dp" android:text="THỬ NHANH (GIẢ LẬP, KHÔNG CẦN CUỘC GỌI THẬT)" />
        <Button android:id="@+id/thuDoChuong" style="@style/Nut.Vien" android:layout_marginTop="8dp" android:text="Thẻ cảnh báo khi đổ chuông" />
        <Button android:id="@+id/thuNhan" style="@style/Nut.Vien" android:layout_marginTop="8dp" android:text="Nhãn nhẹ “giao hàng” khi đổ chuông" />
        <Button android:id="@+id/thuSauGoi" style="@style/Nut.Vien" android:layout_marginTop="8dp" android:text="Bé Nai hỏi sau cuộc gọi lạ" />
        <Button android:id="@+id/thuDungLai" style="@style/Nut.Vien" android:layout_marginTop="8dp" android:text="Màn “Dừng lại”" />
        <Button android:id="@+id/thuTinNhan" style="@style/Nut.Vien" android:layout_marginTop="8dp" android:text="Tin nhắn việc nhẹ lương cao" />
        <Button android:id="@+id/thuCuaSo" style="@style/Nut.Vien" android:layout_marginTop="8dp" android:text="Mở 2 phút canh app ngân hàng" />
        <Button android:id="@+id/moBaiHoc" style="@style/Nut.Vien" android:layout_marginTop="8dp" android:text="Bài học" />
        <Button android:id="@+id/thuGoiVideo" style="@style/Nut.Vien" android:layout_marginTop="8dp" android:text="Gọi video chị Lan (AI đóng vai)" />
        <Button android:id="@+id/goiMinh1" style="@style/Nut.Vien" android:layout_marginTop="8dp" android:text="Gọi video · Anh Minh hoảng hốt gọi" />
        <Button android:id="@+id/goiMinh3" style="@style/Nut.Vien" android:layout_marginTop="8dp" android:text="Gọi video · Anh Minh hỏi mẹ về bé Vy" />
        <Button android:id="@+id/goiTu9" style="@style/Nut.Vien" android:layout_marginTop="8dp" android:text="Khuyên chú Tư · đầu tư lãi cao" />

        <TextView style="@style/Chu.Muc" android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginTop="26dp" android:text="NHẬT KÝ (MỚI NHẤT Ở TRÊN)" />
        <TextView android:id="@+id/nhatKy" style="@style/Chu.Phu" android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginTop="8dp" android:background="@drawable/the" android:fontFamily="monospace" android:padding="12dp" android:textIsSelectable="true" android:textSize="12sp" />
        <Button android:id="@+id/nutXoaNhatKy" style="@style/Nut.Vien" android:layout_marginTop="8dp" android:text="Xóa nhật ký" />
    </LinearLayout>
</ScrollView>
