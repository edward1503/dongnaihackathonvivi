<?xml version="1.0" encoding="utf-8"?>
<!-- A05b: phân tích tin nhắn, tô từng dấu hiệu ngay trong bong bóng tin (cỡ chữ lớn cho người cao tuổi) -->
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent" android:layout_height="match_parent"
    android:background="@color/bg" android:fillViewport="true" android:fitsSystemWindows="true">
    <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content" android:orientation="vertical" android:paddingStart="16dp" android:paddingEnd="16dp" android:paddingBottom="20dp">

        <!-- Thanh tiêu đề -->
        <LinearLayout android:layout_width="match_parent" android:layout_height="64dp" android:gravity="center_vertical" android:orientation="horizontal">
            <ImageView android:id="@+id/nutQuayLai" style="@style/IconButton" android:contentDescription="Quay lại" android:src="@drawable/ic_arrow_left" />
            <TextView style="@style/Text.BarTitle" android:layout_width="0dp" android:layout_height="wrap_content" android:layout_marginStart="12dp" android:layout_weight="1" android:text="Phân tích tin nhắn" />
        </LinearLayout>

        <!-- Người gửi -->
        <TextView android:id="@+id/nguoiGui" style="@style/Text.Chip" android:layout_width="wrap_content" android:layout_height="wrap_content" android:layout_marginTop="4dp" android:background="@drawable/chip_outline" android:drawableStart="@drawable/ic_message_16" android:drawableTint="@color/ink_2" android:textColor="@color/ink_2" />

        <!-- Bong bóng tin nhắn đến -->
        <TextView android:id="@+id/noiDung" style="@style/Text.Label" android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginTop="12dp" android:background="@drawable/bubble_incoming" android:paddingStart="14dp" android:paddingTop="12dp" android:paddingEnd="14dp" android:paddingBottom="12dp" android:lineHeight="26sp" />

        <!-- Kết luận -->
        <LinearLayout android:id="@+id/theKq" android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginTop="12dp" android:background="@drawable/the_do" android:gravity="center_vertical" android:orientation="horizontal" android:padding="16dp">
            <ImageView android:id="@+id/mucIcon" android:layout_width="48dp" android:layout_height="48dp" android:background="@drawable/box_danger_solid" android:importantForAccessibility="no" android:padding="12dp" android:src="@drawable/ic_alert_octagon" android:tint="@color/surface" />
            <LinearLayout android:layout_width="0dp" android:layout_height="wrap_content" android:layout_marginStart="12dp" android:layout_weight="1" android:orientation="vertical">
                <TextView android:id="@+id/muc" style="@style/Text.Heading" android:layout_width="match_parent" android:layout_height="wrap_content" android:textColor="@color/danger_ink" />
                <TextView android:id="@+id/kieu" style="@style/Text.Label" android:layout_width="match_parent" android:layout_height="wrap_content" android:textColor="@color/danger_ink" />
            </LinearLayout>
        </LinearLayout>

        <!-- Việc nên làm ngay -->
        <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginTop="12dp" android:background="@drawable/card_soft" android:gravity="center_vertical" android:orientation="horizontal" android:paddingStart="16dp" android:paddingTop="12dp" android:paddingEnd="16dp" android:paddingBottom="12dp">
            <ImageView android:layout_width="24dp" android:layout_height="24dp" android:importantForAccessibility="no" android:src="@drawable/ic_hand" android:tint="@color/danger" />
            <TextView android:id="@+id/loiKhuyen" style="@style/Text.Label.Bold" android:layout_width="0dp" android:layout_height="wrap_content" android:layout_marginStart="12dp" android:layout_weight="1" />
        </LinearLayout>

        <!-- Dấu hiệu -->
        <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginTop="12dp" android:background="@drawable/card_ai" android:orientation="vertical" android:padding="16dp">
            <TextView android:id="@+id/nguon" style="@style/Text.Caption.Bold" android:layout_width="match_parent" android:layout_height="wrap_content" android:drawableStart="@drawable/ic_sparkles_16" android:drawablePadding="6dp" android:drawableTint="@color/ai" android:text="Dấu hiệu nhận ra" android:textColor="@color/ai" />
            <TextView android:id="@+id/dauHieu" style="@style/Text.Label" android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginTop="6dp" android:lineHeight="30sp" android:textColor="@color/ai_ink" />
        </LinearLayout>

        <!-- Báo cho cộng đồng -->
        <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginTop="12dp" android:background="@drawable/card_brand" android:orientation="vertical" android:padding="16dp">
            <TextView android:id="@+id/smsReportTitle" style="@style/Text.Label.Bold" android:layout_width="match_parent" android:layout_height="wrap_content" android:text="Báo tin này cho cộng đồng?" android:textColor="@color/brand_ink" />
            <TextView android:id="@+id/smsReportInfo" style="@style/Text.Caption" android:accessibilityLiveRegion="polite" android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginTop="2dp" android:text="Số điện thoại, số tài khoản trong tin được che trước khi gửi." android:textColor="@color/brand_ink" />
            <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginTop="12dp" android:orientation="horizontal">
                <Button android:id="@+id/nutBao" style="@style/Button.Primary" android:layout_width="0dp" android:layout_weight="2" android:text="Báo cho cộng đồng" />
                <Space android:layout_width="8dp" android:layout_height="1dp" />
                <Button android:id="@+id/nutKhong" style="@style/Button.Outline" android:layout_width="0dp" android:layout_weight="1" android:paddingStart="8dp" android:paddingEnd="8dp" android:text="Không" />
            </LinearLayout>
        </LinearLayout>
    </LinearLayout>
</ScrollView>
