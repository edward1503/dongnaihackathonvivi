<?xml version="1.0" encoding="utf-8"?>
<!-- A10a, A10b: màn "Dừng lại" toàn màn hình, theo bản thiết kế chữ lớn:
     nhãn trắng trên cùng, bàn tay trong vòng tròn trắng, chữ DỪNG LẠI, thẻ trắng ở giữa khoảng trống, hai nút lớn và dòng nhắc cuối. -->
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent" android:layout_height="match_parent"
    android:background="@color/danger" android:fillViewport="true" android:fitsSystemWindows="true">
    <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content" android:gravity="center_horizontal" android:orientation="vertical" android:paddingStart="16dp" android:paddingTop="16dp" android:paddingEnd="16dp" android:paddingBottom="12dp">
        <TextView android:id="@+id/dongTren" style="@style/Text.Chip" android:layout_width="wrap_content" android:layout_height="wrap_content" android:background="@drawable/chip_white" android:drawableStart="@drawable/ic_volume_16" android:drawableTint="@color/danger" android:minHeight="36dp" android:paddingStart="14dp" android:paddingEnd="16dp" android:text="Đang đọc to" android:textColor="@color/danger_ink" />

        <Space android:layout_width="1dp" android:layout_height="20dp" android:layout_weight="1" />
        <ImageView android:layout_width="88dp" android:layout_height="88dp" android:background="@drawable/circle_white" android:importantForAccessibility="no" android:padding="20dp" android:src="@drawable/ic_hand" android:tint="@color/danger" />

        <TextView android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginTop="20dp" android:fontFamily="@font/bvp_bold" android:gravity="center" android:lineHeight="52sp" android:text="DỪNG LẠI" android:textColor="@color/surface" android:textSize="44sp" />
        <TextView android:id="@+id/lyDo" style="@style/Text.Body" android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginTop="8dp" android:gravity="center" android:textColor="@color/surface" />

        <Space android:layout_width="1dp" android:layout_height="20dp" android:layout_weight="1" />
        <LinearLayout android:id="@+id/theLoi" android:layout_width="match_parent" android:layout_height="wrap_content" android:background="@drawable/card_white_large" android:orientation="vertical" android:paddingStart="20dp" android:paddingTop="24dp" android:paddingEnd="20dp" android:paddingBottom="24dp">
            <TextView android:id="@+id/loi1" style="@style/Text.Heading" android:layout_width="match_parent" android:layout_height="wrap_content" android:gravity="center" android:textColor="@color/danger_ink" />
            <TextView android:id="@+id/loi2" style="@style/Text.Label" android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginTop="8dp" android:gravity="center" />
        </LinearLayout>
        <Space android:layout_width="1dp" android:layout_height="20dp" android:layout_weight="1" />

        <Button android:id="@+id/nutCup" style="@style/Button.White.Large" android:layout_marginBottom="12dp" android:text="Cúp máy ngay" android:visibility="gone" />
        <Button android:id="@+id/nutHoi" style="@style/Button.White.Large" />
        <Button android:id="@+id/nutDong" style="@style/Button.OnRed.Large" android:layout_marginTop="12dp" android:text="Đóng cảnh báo" />
        <TextView style="@style/Text.Caption" android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginTop="12dp" android:gravity="center" android:text="Không cơ quan nào yêu cầu\nchuyển tiền qua điện thoại." android:textColor="@color/surface" />
    </LinearLayout>
</ScrollView>
