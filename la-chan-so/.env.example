# Khóa riêng của kho Lá chắn số. Chép tệp này thành .env rồi điền; tệp .env không bao giờ được đưa lên git.
# Nạp vào một lệnh:  set -a; . ./.env; set +a

# OpenAI: AI phân tích tin nhắn, lời kể, bản ghi âm (mảng 2) và chấm bài nói (mảng 4)
OPENAI_API_KEY=
# Để trống thì dùng địa chỉ mặc định của OpenAI
OPENAI_BASE_URL=
# Tên model muốn dùng, ví dụ model chữ và model nghe; để trống thì mã dùng mặc định của từng chỗ
OPENAI_MODEL=
OPENAI_STT_MODEL=

# Gemini: thu giọng Bé Nai và các nhân vật (tools/gemini_*.py). Nhiều khóa thì cách nhau bằng dấu phẩy
GEMINI_API_KEYS=
